// La Gazzetta Civica — persistent Supabase PostgreSQL schema.
//
// `url` uses Supabase's transaction-mode pooler (pgbouncer, port 6543) for
// normal app queries; `directUrl` uses the session-mode pooler (port 5432),
// which Prisma Migrate needs for schema changes since pgbouncer's
// transaction mode doesn't support prepared statements / advisory locks.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Act {
  id              String         @id
  code            String         @unique
  formalTitle     String
  officialTitle   String
  popularTitle    String
  summary         String
  date            String
  publishedAt     String?
  inForceAt       String?
  sourceUrl       String
  sourceLabel     String
  iniziativa      String // 'governo' | 'parlamentare' | 'popolare'
  materia         String // 'fisco' | 'lavoro' | 'sanita' | 'giustizia' | 'codice_strada'
  copertura       String // 'a_debito' | 'tagli_spesa' | 'invarianza'
  iterStatus      String // 'in_commissione' | 'in_aula' | 'navetta_senato' | 'promulgata'
  decreesMissing  Int            @default(0)
  decreeDeadline  String?
  financialNote   String
  omnibusRisk     Json? // { article: string, description: string }
  lobbyCheck      Json? // { similarity: number, source: string }
  urgency         Int            @default(50)
  ministry        String
  preamble        String
  createdAt       DateTime       @default(now())
  articles        Article[]
  votes           VoteBreakdown?

  @@index([iterStatus])
  @@index([iniziativa])
  @@index([materia])
  @@index([copertura])
  @@index([date])
}

model Article {
  id                 String       @id @default(cuid())
  actId              String
  number             String
  heading            String
  original           String       @db.Text
  structured         String       @db.Text
  simple             String       @db.Text
  exhaustiveAnalysis String?      @db.Text
  practicalImpact    String?      @db.Text
  prosObjective      String[]     @default([])
  consObjective      String[]     @default([])
  orderIndex         Int          @default(0)
  act                Act          @relation(fields: [actId], references: [id], onDelete: Cascade)
  impacts            NormImpact[]

  @@index([actId])
}

model NormImpact {
  id                  String  @id @default(cuid())
  articleId           String
  modifiedActCode     String
  targetArticle       String
  impactType          String
  previousRuleSummary String  @db.Text
  newEffectSummary    String  @db.Text
  officialSourceUrl   String?
  article             Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

/// PHASE 3 — semantic cache for `app/api/rag/route.ts`. Keyed on a
/// normalized (`trim().toLowerCase()`, plus `::actId` when scoped) query
/// string, so an identical follow-up question is served from Postgres in
/// well under 50ms and burns zero further Gemini tokens. `extendedAnalysis`
/// stores the full Stage 2 payload (`ExtendedHistoricalAnalysis` from
/// `lib/types/rag.ts`: historical narrative, resolved foundation statutes,
/// comparative table, neutral dossier) as a single JSON blob.
model RagQueryCache {
  id               String   @id @default(cuid())
  normalizedQuery  String   @unique
  actId            String?
  answer           String   @db.Text
  citations        Json
  extendedAnalysis Json
  hitCount         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([normalizedQuery])
  @@index([actId])
}

model VoteBreakdown {
  id         String @id @default(cuid())
  actId      String @unique
  favorevoli Int    @default(0)
  contrari   Int    @default(0)
  astenuti   Int    @default(0)
  pctFav     Float  @default(0)
  pctCont    Float  @default(0)
  pctAst     Float  @default(0)
  act        Act    @relation(fields: [actId], references: [id], onDelete: Cascade)
}
